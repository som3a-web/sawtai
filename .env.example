COMPOSE_PROJECT_NAME=sawtai
SAWTAI_ENV=development
SAWTAI_LOG_LEVEL=INFO

POSTGRES_DB=sawtai
POSTGRES_USER=sawtai
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+asyncpg://sawtai:change-me-for-local-development@postgres:5432/sawtai
ALEMBIC_DATABASE_URL=postgresql+psycopg://sawtai:change-me-for-local-development@postgres:5432/sawtai

REDIS_URL=redis://redis:6379/0
MINIO_ROOT_USER=sawtai-local
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_ENDPOINT=http://minio:9000
MINIO_RAW_BUCKET=sawtai-raw
MINIO_MEDIA_BUCKET=sawtai-media
MINIO_EXPORTS_BUCKET=sawtai-exports

JWT_SECRET=replace-with-at-least-32-random-bytes
TENANT_PEPPER=replace-with-32-random-bytes
PII_ENCRYPTION_KEY=replace-with-32-random-bytes
ENCODERS_URL=http://encoders:8001
LLM_BASE_URL=http://llm:8000/v1

# Meta WhatsApp Cloud API. Leave delivery in simulate mode until configured.
WHATSAPP_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SIGNATURE_REQUIRED=true
WHATSAPP_DELIVERY_MODE=simulate
WHATSAPP_REPLY_MODE=draft
WHATSAPP_TENANT_CODE=shj-demo
WHATSAPP_SOURCE_HANDLE=demo-whatsapp
RAG_LEXICAL_GATE=0.18
